{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "agiletalks-workshop",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/workshop/marshmallow/**",
        "destination": "/workshop/marshmallow/index.html"
      }
    ]
  }
}
